{
  "expo": {
    "name": "CHROMAWAVE",
    "slug": "chromawave",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/ios/AppIcon.appiconset/chromawave-primary-1024.png",
    "scheme": "chromawave",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/brand/ios/AppIcon.appiconset/chromawave-primary-1024.png",
        "dark": "./assets/brand/ios/AppIcon.appiconset/chromawave-dark-1024.png",
        "tinted": "./assets/brand/ios/AppIcon.appiconset/chromawave-tinted-1024.png"
      },
      "supportsTablet": true,
      "bundleIdentifier": "com.chromawave.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0C0B18",
        "foregroundImage": "./assets/brand/android/ic_launcher_foreground.png",
        "monochromeImage": "./assets/brand/android/ic_launcher_monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.chromawave.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/web/favicon-48.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C0B18",
          "image": "./assets/brand/splash/splash-source.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0C0B18",
            "image": "./assets/brand/splash/splash-source.png"
          },
          "android": {
            "backgroundColor": "#0C0B18",
            "image": "./assets/brand/splash/splash-source.png",
            "imageWidth": 160
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CHROMAWAVE to choose a photo only when you start a Memory.",
          "cameraPermission": "Allow CHROMAWAVE to take a photo for a new private Memory.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#DCC28E",
          "defaultChannel": "chromatic-reminder",
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
