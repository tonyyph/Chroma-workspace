{
  "expo": {
    "name": "Chroma Wave",
    "slug": "chromawave",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/ios/AppIcon.appiconset/icon-primary-1024.png",
    "scheme": "chromawave",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/brand/ios/AppIcon.appiconset/icon-primary-1024.png",
        "dark": "./assets/brand/ios/AppIcon.appiconset/icon-dark-1024.png",
        "tinted": "./assets/brand/ios/AppIcon.appiconset/icon-tinted-1024.png"
      },
      "supportsTablet": true,
      "bundleIdentifier": "com.chromawave.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Chroma Wave uses the camera to read colour from what you point at. Frames are analysed on device and discarded unless you save a capture."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0C0B18",
        "foregroundImage": "./assets/brand/android/ic_launcher_foreground.png",
        "monochromeImage": "./assets/brand/android/ic_launcher_monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.chromawave.app",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/web/favicon-48.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C0B18",
          "image": "./assets/brand/splash/splash-source.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0C0B18",
            "image": "./assets/brand/splash/splash-source.png"
          },
          "android": {
            "backgroundColor": "#0C0B18",
            "image": "./assets/brand/splash/splash-source.png",
            "imageWidth": 160
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Chroma Wave to choose a photo only when you start a Memory.",
          "microphonePermission": false,
          "cameraPermission": "Chroma Wave uses the camera to read colour from what you point at. Frames are analysed on device and discarded unless you save a capture."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#DCC28E",
          "defaultChannel": "chromatic-reminder",
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d6cc3c4e-e6c7-456b-8a3f-482a23401abc"
      }
    },
    "owner": "cuongphan2"
  }
}