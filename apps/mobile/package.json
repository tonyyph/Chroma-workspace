  "devDependencies": {
    "@react-native/assets-registry": "0.83.10",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "26.1.1",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~55.0.8",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~55.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.20",
    "typescript": "~5.9.2"
