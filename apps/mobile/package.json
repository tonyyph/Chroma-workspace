{
  "name": "@chromawave/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "prebuild:ios": "node ./scripts/ensure-skia.mjs && expo prebuild --platform ios",
    "android": "expo run:android",
    "ios": "node ./scripts/ensure-skia.mjs && sh ./scripts/run-ios.sh",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest --runInBand",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@chromawave/analytics": "workspace:*",
